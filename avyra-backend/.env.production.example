# Production template for the Laravel API on api.avyrabd.com.
# Copy to .env on the server and fill in the blanks — never commit the filled copy.

APP_NAME="Avyra Wellness"
APP_ENV=production
# php artisan key:generate  (leave blank here; generate on the server)
APP_KEY=
# Leaving this on in production prints database credentials on any error page.
APP_DEBUG=false
APP_URL=https://api.avyrabd.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# ── Database ───────────────────────────────────────────────────────────────
# config/database.php pins the engine to InnoDB: UUID foreign keys need it, and
# MyISAM drops them silently. Confirm with SHOW ENGINES on the host.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sessions & SPA auth ────────────────────────────────────────────────────
# Cookie auth only works when the API and the front end share a registrable
# domain. The leading dot covers both avyrabd.com and api.avyrabd.com.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.avyrabd.com
SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=avyrabd.com,www.avyrabd.com
FRONTEND_URL=https://avyrabd.com
# Must list every origin the browser calls from; keep in step with the line
# above. A missing entry shows up as a login that silently fails.
CORS_ALLOWED_ORIGINS=https://avyrabd.com,https://www.avyrabd.com

# ── Proxies ────────────────────────────────────────────────────────────────
# Set this whenever PHP sits behind LiteSpeed, nginx or Cloudflare, or every
# customer will share the proxy's IP: the fraud detector's repeat-IP rule would
# then treat unrelated buyers as one person and block them. `*` trusts the
# immediate peer, which is right on shared hosting.
TRUSTED_PROXIES=*

# ── Storage ────────────────────────────────────────────────────────────────
# Uploads are written to the public disk and served through the storage symlink:
# run `php artisan storage:link` after deploying.
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@avyrabd.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Facebook Conversions API ───────────────────────────────────────────────
# Server side only — never prefix with NEXT_PUBLIC_. The pixel id is also set
# in the front end's own env; the two must match or events will not dedupe.
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
FB_API_VERSION=v20.0
# Only set while testing against Events Manager; must be empty in production.
FB_TEST_EVENT_CODE=
